{
  "expo": {
    "name": "Minha Lista de Compras",
    "slug": "minha-lista-de-compras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permitir que o app acesse a câmera para ler etiquetas de preço",
        "NSPhotoLibraryUsageDescription": "Permitir que o app acesse suas fotos para ler etiquetas de preço"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803D"
      },
      "package": "com.moraesernane.minhalistadecompras",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/json"
            },
            {
              "scheme": "file",
              "mimeType": "application/json"
            },
            {
              "scheme": "content",
              "mimeType": "application/zip"
            },
            {
              "scheme": "file",
              "mimeType": "application/zip"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-zip-compressed"
            },
            {
              "scheme": "file",
              "mimeType": "application/x-zip-compressed"
            },
            {
              "scheme": "content",
              "mimeType": "text/plain",
              "pathPattern": ".*\\.(json|zip)"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain",
              "pathPattern": ".*\\.(json|zip)"
            },
            {
              "scheme": "content",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.(json|zip)"
            },
            {
              "scheme": "file",
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.(json|zip)"
            }
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que o app acesse a câmera para ler etiquetas de preço"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que o app acesse a câmera para ler etiquetas de preço",
          "photosPermission": "Permitir que o app acesse suas fotos para ler etiquetas de preço"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome6_Regular.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome6_Solid.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/FontAwesome6_Brands.ttf"
          ]
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Minha Lista de Compras",
      "shortName": "Minha Lista",
      "description": "Aplicativo para gerenciar suas listas de compras e controlar seus gastos no supermercado.",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "7fa8bc46-fbf0-4ebd-b6ad-d35ae91e35ae"
      }
    }
  }
}
